    "turbo": "^2.9.18",
    "typescript": "5.9.2",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "@trpc/server": "^11.18.0",
    "prisma": "^7.8.0",
    "superjson": "^2.2.6",
