DATABASE_URL="postgresql://postgres:password@localhost:5432/shipflow"
BETTER_AUTH_SECRET="your-super-secret-auth-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# 3. AI Providers (Provide AT LEAST ONE)
# OpenAI (Primary)
OPENAI_API_KEY="sk-..."
# Mistral (Fallback/Alternative)
MISTRAL_API_KEY="your-mistral-api-key"

# 4. GitHub App Integration
# The numeric ID of your GitHub App
GITHUB_APP_ID="123456"
# The exact name/slug of the GitHub App
NEXT_PUBLIC_GITHUB_APP_NAME="the-wharf-ai-dev"
# The private key for the GitHub App (Ensure newlines are handled correctly if hosting in Vercel/Render)
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Secret for verifying incoming GitHub webhooks
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret"

# 5. Billing (Razorpay)
# The public key ID for your Razorpay account
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_ID="rzp_test_..."
# The secret key for your Razorpay account
RAZORPAY_KEY_SECRET="your-razorpay-secret"
# Secret for verifying incoming Razorpay webhooks
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
# The Plan ID for the PRO tier subscription
RAZORPAY_PRO_PLAN_ID="plan_..."

# 6. Rate Limiting (Upstash Redis)
# Get these from your Upstash console (Required for Vercel Edge rate limiting)
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# 7. Observability (Optional)
# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."
