generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  featureRequests FeatureRequest[]
  assignedTasks   Task[]
  auditLogs       AuditLog[]

  @@map("user")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime
  updatedAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String?      @unique
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  projects    Project[]
  githubInstallation GithubInstallation?
  auditLogs   AuditLog[]

  // Billing & Usage
  plan                   String   @default("FREE")
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  subscriptionStatus     String   @default("active")
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  aiReviewsUsed          Int      @default(0)

  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

model Project {
  id             String         @id @default(cuid())
  name           String
  description    String?
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  featureRequests FeatureRequest[]
  repositories    ProjectRepository[]
  tasks           Task[]

  intakeToken         String?  @unique
  publicIntakeEnabled Boolean  @default(false)

  @@map("project")
}

enum FeatureRequestStatus {
  PENDING
  UNDER_REVIEW
  DUPLICATE_DETECTED
  PLANNED
  IN_PROGRESS
  READY_FOR_APPROVAL
  REVISION_NEEDED
  SHIPPED
  REJECTED
}

enum FeatureRequestSource {
  FORM
  EMAIL
  TICKET
  CALL
}

enum ClarificationStatus {
  NONE
  AWAITING_RESPONSE
  RESOLVED
}

enum ProcessingState {
  IDLE
  ANALYZING_INTAKE
  GENERATING_PRD
  GENERATING_TASKS
}

model FeatureRequest {
  id             String               @id @default(cuid())
  title          String
  content        String
  status         FeatureRequestStatus @default(PENDING)
  source         FeatureRequestSource
  sourceMetadata Json?
  submitterEmail String?
  submitterName  String?
  approvalNotes  String?
  projectId      String
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  isSpecificEnough     Boolean?
  missingDimensions    String[]            @default([])
  followUpQuestions    String[]            @default([])
  clarificationStatus  ClarificationStatus @default(NONE)
  processingState      ProcessingState     @default(IDLE)
  clarificationMessages ClarificationMessage[]
  embedding            Unsupported("vector(1024)")?

  // Duplicate detection fields
  duplicateOfId  String?
  duplicateOf    FeatureRequest?      @relation("DuplicateRelation", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates     FeatureRequest[]     @relation("DuplicateRelation")
  duplicateNote  String?              // AI-generated explanation of why this is a duplicate
  duplicateSimilarity Float?          // Cosine similarity score (0-1)

  // PRD link
  prd            PRD?
  
  // Tasks
  tasks          Task[]

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("feature_request")
}

model PRD {
  id               String         @id @default(cuid())
  featureRequestId String         @unique
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)

  // Structured fields
  problemStatement String
  goals            String[]
  nonGoals         String[]
  userStories      String[]
  acceptanceCriteria String[]
  edgeCases        String[]
  successMetrics   String[]

  isFinalized      Boolean        @default(false)
  planApprovedAt   DateTime?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("prd")
}

model ClarificationMessage {
  id               String         @id @default(cuid())
  featureRequestId String
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  role             String         // "assistant" or "user"
  content          String
  round            Int            // which clarification round (1, 2, 3...)
  createdAt        DateTime       @default(now())

  @@map("clarification_message")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskCategory {
  FRONTEND
  BACKEND
  INFRA
  DESIGN
  FULLSTACK
}

enum TaskEffort {
  S
  M
  L
  XL
}

model Task {
  id               String         @id @default(cuid())
  projectId        String
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number           Int
  featureRequestId String
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)

  title            String
  description      String
  status           TaskStatus     @default(TODO)
  category         TaskCategory
  effort           TaskEffort?
  
  // Traceability
  satisfiedAcceptanceCriteria String[] // Exact strings from the PRD
  traceabilityNotes           String?  // Brief explanation of how it meets the criteria

  // Assignment & Linking
  assigneeId       String?
  assignee         User?          @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  linkedPrUrls     String[]       @default([])
  pullRequests     PullRequest[]  @relation("TaskPullRequests")
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([projectId, number])
  @@map("task")
}

model GithubInstallation {
  id               String        @id @default(cuid())
  organizationId   String?       @unique
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  installationId   Int           @unique
  accountName      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  repositories     GithubRepository[]

  @@map("github_installation")
}

model GithubInstallState {
  id               String        @id @default(cuid())
  token            String        @unique
  organizationId   String
  userId           String
  expiresAt        DateTime
  createdAt        DateTime      @default(now())

  @@map("github_install_state")
}

model GithubRepository {
  id               String               @id @default(cuid())
  installationId   String
  installation     GithubInstallation   @relation(fields: [installationId], references: [id], onDelete: Cascade)
  repoId           Int                  @unique
  fullName         String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  projects         ProjectRepository[]
  pullRequests     PullRequest[]

  @@map("github_repository")
}

model ProjectRepository {
  projectId        String
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryId     String
  repository       GithubRepository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdAt        DateTime             @default(now())

  @@id([projectId, repositoryId])
  @@map("project_repository")
}

model GithubWebhookLog {
  id           String   @id @default(cuid())
  githubEvent  String   // e.g., "pull_request", "installation"
  githubAction String?  // e.g., "opened", "synchronize", "closed"
  payload      Json
  createdAt    DateTime @default(now())

  @@map("github_webhook_log")
}

enum PRReviewStatus {
  PENDING
  AWAITING_TASK_LINK
  APPROVED
  NEEDS_FIX
}

model PullRequest {
  id              String           @id @default(cuid())
  githubId        Int              @unique
  number          Int
  title           String
  state           String
  reviewStatus    PRReviewStatus   @default(PENDING)
  url             String
  authorLogin     String
  repositoryId    String
  repository      GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  mergedAt        DateTime?
  tasks           Task[]           @relation("TaskPullRequests")
  reviewRuns      ReviewRun[]

  @@map("pull_request")
}

model ReviewRun {
  id            String         @id @default(cuid())
  pullRequestId String
  pullRequest   PullRequest    @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  headSha       String
  conclusion    PRReviewStatus // The conclusion for this specific run
  summary       String         @db.Text
  createdAt     DateTime       @default(now())
  issues        ReviewIssue[]

  @@map("review_run")
}

model ReviewIssue {
  id          String    @id @default(cuid())
  reviewRunId String
  reviewRun   ReviewRun @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)
  filePath    String
  snippet     String    @db.Text
  comment     String    @db.Text
  isBlocking  Boolean
  category    String

  @@map("review_issue")
}

enum AuditEventType {
  APPROVAL_GRANTED
  ROLE_CHANGED
  BILLING_UPGRADED
  BILLING_CANCELLED
  MEMBER_INVITED
  MEMBER_REMOVED
  FEATURE_SHIPPED
}

model AuditLog {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType      AuditEventType
  metadata       Json?          // Dynamic payload describing the event (e.g. { "featureRequestId": "...", "role": "admin" })
  ipAddress      String?
  createdAt      DateTime       @default(now())

  @@map("audit_log")
}

